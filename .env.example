# Ambiente: "local" desabilita cache do axios; "production" habilita cache de 1h
VUE_APP_ENV=local

# Caminho ou URL do arquivo JSON de projetos (relativo a /public ou URL absoluta)
VUE_APP_DATABASE=/examples/projects.json

# ─── Autenticação do dashboard (login global) ────────────────────────────────
# "true" ativa a tela de login; "false" acesso direto ao dashboard
VUE_APP_LOGIN=false

# URL do endpoint de login (POST)
VUE_APP_LOGIN_URL=

# Nome do campo de usuário enviado no body
VUE_APP_LOGIN_USER_FIELD=email

# Nome do campo de senha enviado no body
VUE_APP_LOGIN_PASS_FIELD=password

# Caminho no objeto de resposta onde está o token (ex: "data.token")
VUE_APP_LOGIN_TOKEN_PATH=token

# Nome do header HTTP usado para enviar o token nas requisições
VUE_APP_LOGIN_TOKEN_HEADER=access-token

# Modo de envio do token: "header" ou "query"
VUE_APP_LOGIN_TOKEN_MODE=header

# Template do valor do token (ex: "Bearer {token}")
VUE_APP_LOGIN_TOKEN_HEADER_EXPRESSION={token}

# URL para verificar se a sessão ainda é válida (GET)
VUE_APP_LOGGED_URL=

# Headers padrão enviados em todas as requisições (JSON string)
# Exemplo: {"x-app-key":"abc123"}
VUE_APP_DEFAULT_HEADERS=

# ─── API interna (funções Vercel) ─────────────────────────────────────────────
# Deve ser igual à variável API_SECRET configurada no painel da Vercel
# Gere um valor seguro: openssl rand -hex 32
VUE_APP_API_SECRET=
